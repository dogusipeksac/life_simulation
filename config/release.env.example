# Copy to ~/.config/life-simulation/release.env (chmod 600).
# The parser reads literal KEY=VALUE lines. It does not execute shell code.
# Confirm these IDs in your own Play Console / App Store Connect first.
ANDROID_PACKAGE=com.life.simulation
IOS_BUNDLE_ID=com.life.simulation
PLAY_JSON_KEY=~/.config/life-simulation/play-service-account.json
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=~/.config/life-simulation/AuthKey_KEYID.p8
IOS_EXPORT_OPTIONS_PLIST=~/.config/life-simulation/ExportOptions.plist
