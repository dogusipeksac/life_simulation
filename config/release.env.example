# ~/.config/life-simulation/release.env şablonu (chmod 600)
# Bu dosya ortam değişkenleri olarak güvenle okunur, asla repoya eklenmez.

ANDROID_PACKAGE=com.dogusipeksac.lifesimulation
IOS_BUNDLE_ID=com.dogusipeksac.lifesimulation

# Google Play Servis Hesabı JSON yolu
PLAY_JSON_KEY=/Users/dogusipeksac/.config/life-simulation/play-service-account.json

# App Store Connect API Anahtarı (TestFlight & App Store yüklemesi)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=/Users/dogusipeksac/.config/life-simulation/AuthKey_KEYID.p8

# iOS Xcode Export Ayarları
IOS_EXPORT_OPTIONS_PLIST=/Users/dogusipeksac/.config/life-simulation/ExportOptions.plist
