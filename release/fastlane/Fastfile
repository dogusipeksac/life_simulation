default_platform(:ios)

def apple_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILE"),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "TestFlight'a yükle, işlenmesini bekle ve What to Test metnini ekle"
  lane :tf_upload do |options|
    ipa_path = options.fetch(:ipa)
    notes_path = options.fetch(:notes)
    
    upload_to_testflight(
      api_key: apple_api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      ipa: ipa_path,
      changelog: File.read(notes_path, encoding: "UTF-8").strip,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "En son TestFlight build numarasını sorgula"
  lane :latest_build do
    latest_testflight_build_number(
      api_key: apple_api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID")
    )
  end

  desc "App Store Connect sürümüne IPA ve What's New yükle (İncelemeye göndermez)"
  lane :asc_upload do |options|
    upload_to_app_store(
      api_key: apple_api_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      ipa: options.fetch(:ipa),
      app_version: options.fetch(:version),
      release_notes: { "tr" => File.read(options.fetch(:notes), encoding: "UTF-8").strip },
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end

platform :android do
  desc "Google Play'e AAB ve sürüm notu yükle"
  lane :play_upload do |options|
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE"),
      json_key: ENV.fetch("PLAY_JSON_KEY"),
      aab: options.fetch(:aab),
      track: options.fetch(:track, "internal"),
      release_status: options.fetch(:status, "draft"),
      metadata_path: options.fetch(:metadata),
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: options.fetch(:validate_only, false)
    )
  end
end
